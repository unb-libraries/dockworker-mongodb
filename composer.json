{
  "name": "unb-libraries/dockworker-mongodb",
  "description": "Services for wiring up Mongodb containers for development",
  "type": "library",
  "require": {
    "unb-libraries/dockworker-daemon": "6.x-dev"
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "UNB Libraries",
      "email": "libsupport@unb.ca"
    }
  ],
  "autoload": {
    "psr-4": {
      "Dockworker\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
